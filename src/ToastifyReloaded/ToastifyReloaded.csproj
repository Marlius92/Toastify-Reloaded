<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ToastifyReloaded</AssemblyName>
    <RootNamespace>ToastifyReloaded</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\ToastifyIcon.ico</ApplicationIcon>
    <Version>1.3.4</Version>
    <Authors>Toastify Reloaded contributors</Authors>
    <Description>Toastify Reloaded - Windows companion for Spotify with global hotkeys, track popups and Spicetify Lyrics Plus integration.</Description>
  </PropertyGroup>

  <!--
    Maintenance helpers remain editable source files in the repository, but are
    embedded in ToastifyReloaded.exe. They are never installed as loose files.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\install-lyrics.ps1"
                      LogicalName="ToastifyReloaded.Scripts.install-lyrics.ps1" />
    <EmbeddedResource Include="..\..\scripts\restore-after-spotify-update.ps1"
                      LogicalName="ToastifyReloaded.Scripts.restore-after-spotify-update.ps1" />
    <EmbeddedResource Include="..\..\scripts\remove-lyrics.ps1"
                      LogicalName="ToastifyReloaded.Scripts.remove-lyrics.ps1" />
    <EmbeddedResource Include="..\..\scripts\diagnose.ps1"
                      LogicalName="ToastifyReloaded.Scripts.diagnose.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\SpotifyToastifyLogo.png" />
    <Resource Include="Resources\ToastifyIcon.ico" />
  </ItemGroup>
</Project>
