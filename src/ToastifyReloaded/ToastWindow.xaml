<Window x:Class="ToastifyReloaded.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="118"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#F21B1B1B" CornerRadius="12" Padding="16" BorderBrush="#403FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1DB954" CornerRadius="3" Margin="0,2,12,2" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="TOASTIFY MODERN" Foreground="#8FFFFFFF" FontSize="11" FontWeight="SemiBold" />
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                <TextBlock x:Name="ArtistText" Foreground="#CFFFFFFF" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                <TextBlock x:Name="AlbumText" Foreground="#85FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
