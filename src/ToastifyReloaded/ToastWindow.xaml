<Window x:Class="ToastifyReloaded.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="250" Height="70"
        AllowsTransparency="True" Background="#00000000" Opacity="1"
        Title="Toastify Reloaded" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Cursor="Hand" Topmost="True" ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="ToastBorder" BorderBrush="#FF292929" BorderThickness="1" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTranslate" />
        </Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush x:Name="ToastBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop x:Name="TopGradientStop" Color="#FF555555" Offset="0" />
                <GradientStop x:Name="BottomGradientStop" Color="#FF151515" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ArtworkColumn" Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="AlbumArt" Source="Resources/SpotifyToastifyLogo.png" HorizontalAlignment="Right"
                   Margin="0" Height="60" Width="60" Grid.Column="0" VerticalAlignment="Center" Stretch="Fill"
>
                <Image.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" />
                </Image.Effect>
            </Image>
            <Grid x:Name="ToastContentGrid" Grid.Column="1" Margin="15,15,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="19" />
                    <RowDefinition Height="19" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock x:Name="Title1" VerticalAlignment="Bottom" Foreground="White" FontSize="16" TextTrimming="CharacterEllipsis" Grid.Row="0" />
                <TextBlock x:Name="Title2" VerticalAlignment="Top" Margin="1,0,0,0" Foreground="#FFF0F0F0" FontSize="12" TextTrimming="CharacterEllipsis" Grid.Row="1" />
                <Grid x:Name="SongTimelineGrid" Grid.Row="2" Margin="2,0,4,0" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="SongProgressBar" Grid.Column="0" Margin="0,0,4,0" Visibility="Visible">
                        <Separator x:Name="SongProgressBarContainer" VerticalAlignment="Center" Margin="0" MinWidth="0" MinHeight="1" Background="#FF333333" />
                        <Grid x:Name="SongProgressBarFill" HorizontalAlignment="Left" Width="0" MinWidth="0" MinHeight="1" VerticalAlignment="Center">
                            <Separator x:Name="SongProgressBarLine" VerticalAlignment="Center" MinHeight="1" Background="#FFA0A0A0" />
                            <Ellipse x:Name="SongProgressBarLineEllipse" HorizontalAlignment="Right" VerticalAlignment="Center" Width="2" Fill="#FFA0A0A0" Height="3" />
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="SongDurationText" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                               Foreground="#FFF0F0F0" FontSize="9" Text="0:00 / 0:00" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
