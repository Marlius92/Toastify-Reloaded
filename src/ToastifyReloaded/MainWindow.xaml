<Window x:Class="ToastifyReloaded.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toastify Reloaded" Height="690" Width="780"
        MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#111111" Foreground="White">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Toastify Reloaded" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Hotkey globali, popup brano e integrazione Lyrics per Spotify su Windows" Foreground="#BFFFFFFF" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#1B1B1B" CornerRadius="10" Padding="14" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Stato Spotify" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="SpotifyStatusText" Text="Connessione…" Foreground="#BFFFFFFF" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="CurrentTrackText" Text="Nessun brano rilevato" Foreground="#1DB954" FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="Aggiorna" Click="RefreshSpotify_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="#151515" Foreground="White" BorderBrush="#333333">
            <TabItem Header="Hotkey">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Modifica una scorciatoia usando il formato Ctrl+Alt+T, poi premi Salva." Foreground="#BFFFFFFF" Margin="0,0,0,10" />
                    <DataGrid x:Name="HotkeysGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Background="#181818" Foreground="White" RowBackground="#181818"
                              AlternatingRowBackground="#202020" BorderBrush="#333333" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Funzione" Binding="{Binding ActionLabel}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Scorciatoia globale" Binding="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Ripristina predefinite" Click="ResetHotkeys_Click" />
                        <Button Content="Salva hotkey" Click="SaveHotkeys_Click" Background="#1DB954" Foreground="Black" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Popup e avvio">
                <StackPanel Margin="18">
                    <CheckBox x:Name="ShowToastCheckBox" Content="Mostra popup quando cambia il brano" Margin="0,4" />
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Avvia Toastify Reloaded con Windows" Margin="0,8,0,4" />
                    <CheckBox x:Name="StartMinimizedCheckBox" Content="Avvia ridotto nell'area di notifica" Margin="0,8,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="Durata popup (ms):" VerticalAlignment="Center" />
                        <TextBox x:Name="ToastDurationTextBox" Width="90" Margin="10,0,0,0" Padding="6" Text="3500" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Test popup" Click="TestToast_Click" />
                        <Button Content="Salva impostazioni" Click="SaveGeneral_Click" Background="#1DB954" Foreground="Black" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Lyrics">
                <StackPanel Margin="18">
                    <TextBlock Text="Lyrics Plus in Spotify" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#CFFFFFFF" Margin="0,8,0,12"
                               Text="Questa integrazione usa la Custom App Lyrics Plus inclusa in Spicetify. Non contiene o distribuisce testi musicali: abilita soltanto l'interfaccia Lyrics dentro Spotify." />
                    <Button Content="Installa / abilita Lyrics Plus" HorizontalAlignment="Left" Click="InstallLyrics_Click" Background="#1DB954" Foreground="Black" FontWeight="SemiBold" />
                    <Button Content="Ripristina Lyrics dopo un aggiornamento Spotify" HorizontalAlignment="Left" Click="RestoreLyrics_Click" />
                    <Button Content="Rimuovi Lyrics Plus" HorizontalAlignment="Left" Click="RemoveLyrics_Click" />
                    <TextBlock TextWrapping="Wrap" Foreground="#8FFFFFFF" Margin="0,14,0,0"
                               Text="Gli script aprono PowerShell e mostrano ogni operazione. Dopo un aggiornamento di Spotify, usa Ripristina Lyrics oppure esegui spicetify backup apply." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Diagnostica">
                <StackPanel Margin="18">
                    <TextBlock Text="Strumenti" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="#CFFFFFFF" Margin="0,8,0,12"
                               Text="Genera un riepilogo di Windows, Spotify, Spicetify e configurazione Lyrics utile per aprire una issue su GitHub." />
                    <Button Content="Apri diagnostica PowerShell" HorizontalAlignment="Left" Click="Diagnose_Click" />
                    <Button Content="Apri cartella configurazione" HorizontalAlignment="Left" Click="OpenConfigFolder_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="v1.0.2 • Windows 10/11 • Nessuna password Spotify richiesta" Foreground="#75FFFFFF" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Nascondi nella tray" Click="HideToTray_Click" />
                <Button Content="Esci" Click="Exit_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
