<Window
    x:Class="ToastifyReloaded.Mac.ToastWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="350"
    Height="78"
    CanResize="False"
    ShowInTaskbar="False"
    Topmost="True"
    SystemDecorations="None"
    Background="Transparent"
    TransparencyLevelHint="Transparent">

  <Border
      x:Name="RootBorder"
      CornerRadius="4"
      BorderThickness="1"
      Padding="5">
    <Grid ColumnDefinitions="60,*" RowDefinitions="*,Auto">
      <Image
          x:Name="ArtworkImage"
          Width="60"
          Height="60"
          Stretch="UniformToFill"
          Grid.RowSpan="2"/>

      <Grid
          Grid.Column="1"
          Margin="8,0,0,0"
          RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock
            x:Name="TitleText"
            FontSize="15"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis"/>
        <TextBlock
            x:Name="ArtistText"
            Grid.Row="1"
            FontSize="12"
            TextTrimming="CharacterEllipsis"/>
        <TextBlock
            x:Name="TimeText"
            Grid.Row="2"
            FontSize="10"
            Opacity="0.85"/>
      </Grid>

      <ProgressBar
          x:Name="ProgressBar"
          Grid.Row="1"
          Grid.Column="1"
          Margin="8,2,0,0"
          Height="3"
          Minimum="0"
          Maximum="1"
          Value="0"/>
    </Grid>
  </Border>
</Window>
